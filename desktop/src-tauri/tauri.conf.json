{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Agent Studio",
  "version": "0.1.0",
  "identifier": "local.agent.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"label":"main","title":"Local Agent Studio","width":1440,"height":940,"minWidth":900,"minHeight":640,"dragDropEnabled":false}],
    "security": {"csp":"default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17861 ws://127.0.0.1:17861; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'"}
  },
  "bundle": {"active":true,"targets":["nsis"],"icon":["icons/icon.ico","icons/icon.png"],"externalBin":["binaries/agent-backend"],"resources":["resources/agent.toml"]}
}
